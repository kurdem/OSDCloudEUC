# ============================================================================
# ISC DHCP - Beispiel fuer iPXE-Chainloading (UEFI + Legacy)
# Passe subnet, range, next-server (TFTP) und die HTTP-URL an deine Umgebung an.
# ============================================================================

option space ipxe;
option ipxe-encap-opts code 175 = encapsulate ipxe;
option arch code 93 = unsigned integer 16;   # RFC 4578 Client System Architecture

subnet 10.0.0.0 netmask 255.255.255.0 {
    range 10.0.0.100 10.0.0.200;
    option routers 10.0.0.1;
    option domain-name-servers 10.0.0.1;

    next-server 10.0.0.10;   # TFTP-Server mit iPXE-Bootloadern

    if exists user-class and option user-class = "iPXE" {
        # Bereits in iPXE: direkt unser HTTP-Skript laden.
        filename "http://deploy.example.com/osdcloud/boot.ipxe";
    } elsif option arch = 00:07 or option arch = 00:09 {
        # UEFI x64: signierten iPXE-Loader per TFTP.
        filename "snponly.efi";
    } else {
        # BIOS/Legacy: undionly.
        filename "undionly.kpxe";
    }
}
